## Template .env untuk deployment ONLINE (Supabase + Railway/Render)
## Salin isi ini ke pengaturan Environment Variables di platform hosting kamu
## (Railway/Render), JANGAN dipakai untuk development lokal.

APP_NAME="OPS_BOSP SR CBD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Isi dengan URL aplikasi setelah deploy, contoh: https://srcbd-ops-bosp.up.railway.app
APP_URL=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

## --- Database: Supabase Postgres ---
## Project: srcbd-ops-bosp (ap-southeast-1)
## Ambil DB_PASSWORD dari: Supabase Dashboard > Project Settings > Database > Database Password
## (kalau lupa, klik "Reset database password")
DB_CONNECTION=pgsql
DB_HOST=db.wktwkdatixljpjmfrevv.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

## --- Storage: Supabase Storage (S3-compatible), untuk upload Logo Sekolah/Pemda ---
## Ambil dari: Supabase Dashboard > Project Settings > Storage > S3 Connection
## (generate "New access key" di sana untuk AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=logo-sekolah
AWS_ENDPOINT=https://wktwkdatixljpjmfrevv.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=https://wktwkdatixljpjmfrevv.supabase.co/storage/v1/object/public/logo-sekolah

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

## --- Fitur Restore (menu "Backup & Restore" tab "Restore Data & Aplikasi",
## permintaan user 2026-10-14 poin 2) - HANYA perlu diisi kalau restore gagal
## dgn pesan "psql: command not found"/sejenisnya (binary psql tidak
## terdaftar di PATH server). Biasanya TIDAK perlu diisi - psql biasanya
## sudah terpasang bersama paket "postgresql-client" di server yang pg_dump
## (fitur Backup)-nya sudah berjalan normal.
# BACKUP_PSQL_PATH="/usr/bin/psql"

## --- Fitur Sinkronisasi dan Tarik Data (permintaan user 2026-10-14
## poin 3) - WAJIB diisi "online" di server Online ini (instalasi VPS).
## Kalau dikosongkan, defaultnya sudah "online" juga (sisi aman) - tapi
## tetap diisi eksplisit di sini supaya jelas/tidak membingungkan.
SYNC_PERAN=online
